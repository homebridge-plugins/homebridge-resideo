                    "functionBody": "return (model.options && model.options.devices && !model.options.devices[arrayIndices].hide_device && model.options.devices[arrayIndices].retry && model.options.devices[arrayIndices].deviceID);"
                  }
                },
                "external": {
                  "title": "External Accessory",
